# Copiar a .env en el servidor y completar. El .env NO se versiona: lleva
# credenciales. Todo lo que hay acá lo consume docker-compose.yml.
#
#   cp .env.example .env && nano .env
#   docker compose config     # confirma que las variables interpolan bien

TZ=America/Santiago
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────
# MySQL del host Linux (no va en contenedor)
# ─────────────────────────────────────────────────────────────
# host.docker.internal lo resuelve el extra_hosts "host-gateway" del compose.
# Si en este servidor no resolviera, poner directamente 172.28.0.1: es el
# gateway de la red del compose, o sea el propio host.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=codi_soporte

# A COMPLETAR. Debe existir en la MySQL del host con permiso desde la subred
# de Docker, no solo desde localhost:
#   CREATE USER '<usuario>'@'172.28.0.%' IDENTIFIED BY '<clave>';
#   GRANT ALL PRIVILEGES ON codi_soporte.* TO '<usuario>'@'172.28.0.%';
DB_USER=
DB_PASSWORD=

# TABLE_PREFIX de osTicket. No cambiarlo si la base ya está migrada.
DB_TABLE_PREFIX=ost_

# ─────────────────────────────────────────────────────────────
# osTicket
# ─────────────────────────────────────────────────────────────
OSTICKET_PUERTO=9090

# NO CAMBIAR: es el salt con el que se cifró la base que ya está migrada. Con
# otro valor osTicket no descifra las contraseñas de las cuentas de correo ni
# los tokens, y las sesiones dejan de validar.
OSTICKET_SECRET_SALT=i5XcPUvx6wbZIfcOSoN4V6t8nYkLmf31

# Solo se usa para avisar de fallos de conexión a la base.
OSTICKET_ADMIN_EMAIL=desarrollo.ti@alfaromadariaga.cl

# Si algún día osTicket queda detrás de un Nginx/Apache del host, poner acá la
# IP de ese proxy para que osTicket lea la IP real del cliente de
# X-Forwarded-For. Vacío = se ignora la cabecera (correcto sin proxy).
OSTICKET_TRUSTED_PROXIES=
OSTICKET_LOCAL_NETWORKS=127.0.0.0/8

# ─────────────────────────────────────────────────────────────
# osticket_api
# ─────────────────────────────────────────────────────────────
API_PUERTO=9091

# A COMPLETAR: URL pública de osTicket, sin barra final. Es por donde la API
# crea los tickets. Ej: http://192.168.1.50:9090 o http://soporte.dominio.cl:9090
OSTICKET_URL=http://SERVIDOR:9090

# A COMPLETAR: Panel Admin -> Manage -> API Keys. osTicket valida la IP de
# origen de forma EXACTA; como la llamada sale del contenedor y vuelve por el
# puerto publicado del host, la IP que verá es normalmente 172.28.0.1. Está
# explicado en DESPLIEGUE.md.
OSTICKET_API_KEY=
OSTICKET_TIMEOUT=15

# Si osTicket no responde, insertar el ticket directo en MySQL. Ese camino se
# salta filtros, SLA, auto-respuestas y alertas: poner false si se prefiere
# fallar antes que crear un ticket a medias.
OSTICKET_FALLBACK_SQL=true

# A COMPLETAR: claves válidas para el header X-API-Key, separadas por coma.
# Con esto vacío la API rechaza TODAS las peticiones.
API_KEYS=

# IPs y/o rangos CIDR de los sistemas que consumen esta API, separados por
# coma. VACÍO = no se filtra por IP y solo protege la API Key.
IPS_PERMITIDAS=

# Proxies de confianza: solo desde estas IPs se hace caso a X-Forwarded-For
# para determinar la IP real del cliente. Vacío = se ignora la cabecera.
TRUSTED_PROXIES=

CORS_ORIGINS=*
