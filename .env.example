# Copiar a .env en el servidor y completar. El .env NO se versiona: lleva
# credenciales. Todo lo que hay acá lo consume docker-compose.yml.
#
#   cp .env.example .env && nano .env
#   docker compose config     # confirma que las variables interpolan bien

# Nombre del proyecto Compose: prefija la red y el volumen. Va acá y no como
# clave "name:" del docker-compose.yml porque esa clave rompe en Compose V1.
COMPOSE_PROJECT_NAME=codi-soporte

TZ=America/Santiago
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────
# Red Docker del compose
# ─────────────────────────────────────────────────────────────
# Subred fija: el GRANT de MySQL y la IP autorizada de la API Key de osTicket
# dependen de ella, así que no puede quedar al azar.
#
# Si el arranque falla con "Pool overlaps with other one on this address
# space", esta subred choca con otra red del servidor. Ver cuáles están en uso:
#   docker network inspect $(docker network ls -q) --format '{{.Name}}: {{range .IPAM.Config}}{{.Subnet}} {{end}}'
# y elegir un /24 libre (172.29.0.0/24, 172.30.0.0/24...). Al cambiarlo hay que
# actualizar el GRANT de MySQL y la IP de la API Key con el nuevo rango.
RED_SUBNET=172.28.0.0/24
RED_IP_OSTICKET=172.28.0.10
RED_IP_API=172.28.0.20

# ─────────────────────────────────────────────────────────────
# MySQL del host Linux (no va en contenedor)
# ─────────────────────────────────────────────────────────────
# host.docker.internal lo resuelve el extra_hosts "host-gateway" del compose.
# Si en este servidor no resolviera, poner directamente 172.28.0.1: es el
# gateway de la red del compose, o sea el propio host.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=codi_soporte

# A COMPLETAR. Debe existir en la MySQL del host con permiso desde la subred
# de Docker, no solo desde localhost:
#   CREATE USER '<usuario>'@'172.28.0.%' IDENTIFIED BY '<clave>';
#   GRANT ALL PRIVILEGES ON codi_soporte.* TO '<usuario>'@'172.28.0.%';
DB_USER=
DB_PASSWORD=

# TABLE_PREFIX de osTicket. No cambiarlo si la base ya está migrada.
DB_TABLE_PREFIX=ost_

# ─────────────────────────────────────────────────────────────
# osTicket
# ─────────────────────────────────────────────────────────────
OSTICKET_PUERTO=7090

# NO CAMBIAR: es el salt con el que se cifró la base que ya está migrada. Con
# otro valor osTicket no descifra las contraseñas de las cuentas de correo ni
# los tokens, y las sesiones dejan de validar.
OSTICKET_SECRET_SALT=i5XcPUvx6wbZIfcOSoN4V6t8nYkLmf31

# Solo se usa para avisar de fallos de conexión a la base.
OSTICKET_ADMIN_EMAIL=desarrollo.ti@alfaromadariaga.cl

# Si algún día osTicket queda detrás de un Nginx/Apache del host, poner acá la
# IP de ese proxy para que osTicket lea la IP real del cliente de
# X-Forwarded-For. Vacío = se ignora la cabecera (correcto sin proxy).
OSTICKET_TRUSTED_PROXIES=
OSTICKET_LOCAL_NETWORKS=127.0.0.0/8

# ─────────────────────────────────────────────────────────────
# osticket_api
# ─────────────────────────────────────────────────────────────
API_PUERTO=7091

# A COMPLETAR: URL pública de osTicket, sin barra final. Es por donde la API
# crea los tickets. Ej: http://192.168.1.50:7090 o http://soporte.dominio.cl:7090
OSTICKET_URL=http://SERVIDOR:7090

# A COMPLETAR: Panel Admin -> Manage -> API Keys. osTicket valida la IP de
# origen de forma EXACTA; como la llamada sale del contenedor y vuelve por el
# puerto publicado del host, la IP que verá es normalmente 172.28.0.1. Está
# explicado en DESPLIEGUE.md.
OSTICKET_API_KEY=
OSTICKET_TIMEOUT=15
# Timeout aparte para las peticiones CON adjuntos. Debe ser >= al
# max_execution_time de PHP (120s en osTicket/docker/php.ini): si rendimos
# antes que osTicket, él puede terminar creando el ticket que nosotros ya
# dimos por perdido y recreamos por SQL, quedando duplicado.
OSTICKET_TIMEOUT_ADJUNTOS=120
# Tope del conjunto de adjuntos de un ticket, en MB. Por debajo del
# max_file_size de osTicket (32 MB) para poder rechazarlo con un mensaje
# claro en vez de que falle de forma opaca más adelante.
ADJUNTOS_MAX_MB=25
# Tope del contenido que devuelve un detalle con incluir_contenido=true.
# Los archivos van en base64 dentro del JSON y se arman en memoria.
ADJUNTOS_DESCARGA_MAX_MB=15

# Si osTicket no responde, insertar el ticket directo en MySQL. Ese camino se
# salta filtros, SLA, auto-respuestas y alertas: poner false si se prefiere
# fallar antes que crear un ticket a medias.
OSTICKET_FALLBACK_SQL=true

# HEREDADO, normalmente vacío. Claves anónimas que ven TODO el helpdesk.
# Cada consumidor se da de alta con su propia clave y su organización:
#   docker compose exec api python -m scripts.gestionar_clientes alta #     --nombre intranet --org-id 2
# (requiere haber corrido antes osticket_api/sql/001_api_cliente.sql)
API_KEYS=

# Cada cuántos segundos se relee la tabla api_cliente. Es el retardo con el
# que surte efecto dar de baja a un cliente, sin reiniciar el contenedor.
CACHE_CLIENTES_TTL=60

# IPs y/o rangos CIDR de los sistemas que consumen esta API, separados por
# coma. VACÍO = no se filtra por IP y solo protege la API Key.
IPS_PERMITIDAS=

# Proxies de confianza: solo desde estas IPs se hace caso a X-Forwarded-For
# para determinar la IP real del cliente. Vacío = se ignora la cabecera.
TRUSTED_PROXIES=

CORS_ORIGINS=*
