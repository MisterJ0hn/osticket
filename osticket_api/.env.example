# Copiar a .env y ajustar. El .env NO se versiona (lleva credenciales).

APP_ENV=development
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────
# Base de datos de osTicket (solo lectura, salvo el fallback SQL)
# ─────────────────────────────────────────────────────────────
# En desarrollo, la MySQL de XAMPP del host: es la MISMA base que usa el
# contenedor de osTicket de docker-compose.local.yml (él llega por
# host.docker.internal). Si apuntaran a bases distintas, los tickets creados
# no aparecerían en los listados.
# En producción (Hostinger) va el host y el puerto que corresponda.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# También se acepta MYSQL_DATABASE como alias de MYSQL_DB.
MYSQL_DB=temposoft_soporte
MYSQL_USER=root
# El .env.example se versiona: la contraseña real va solo en el .env.
MYSQL_PASSWORD=cambiar

# Prefijo de tablas. Es el TABLE_PREFIX de upload/include/ost-config.php.
OSTICKET_TABLE_PREFIX=ost_

# ─────────────────────────────────────────────────────────────
# API nativa de osTicket (creación de tickets)
# ─────────────────────────────────────────────────────────────
# Sin barra final. En desarrollo, el Docker publica el puerto 8080.
OSTICKET_URL=http://localhost:8080
# Se genera en Panel Admin -> Manage -> API Keys, autorizando la IP DESDE
# la que corre este servicio. Sin esto, osTicket responde 401.
OSTICKET_API_KEY=
OSTICKET_TIMEOUT=15
# Timeout aparte para las peticiones CON adjuntos: subir varios MB y que
# osTicket los decodifique no entra en 15s. Debe ser >= al
# max_execution_time de PHP (120s), o rendimos antes que osTicket y él
# puede terminar creando el ticket que nosotros ya dimos por perdido.
OSTICKET_TIMEOUT_ADJUNTOS=120
# Tamaño máximo del conjunto de adjuntos de un ticket, en MB.
ADJUNTOS_MAX_MB=25
# Si osTicket no responde, insertar el ticket directamente en MySQL.
# Ese camino se salta filtros, SLA, auto-respuestas y alertas: dejarlo en
# false si se prefiere fallar antes que crear un ticket a medias.
OSTICKET_FALLBACK_SQL=true
# osTicket crea el usuario si el email no existe (decisión del proyecto).

# ─────────────────────────────────────────────────────────────
# Seguridad de ESTA api (la que consumen los sistemas externos)
# ─────────────────────────────────────────────────────────────
# HEREDADO. Claves anónimas que ven TODO el helpdesk, sin filtro de
# organización. Lo normal es dejarlo VACÍO: cada consumidor se da de alta en
# la tabla api_cliente, con su propia clave y su organización:
#   mysql -u USUARIO -p BASE < sql/001_api_cliente.sql
#   python -m scripts.gestionar_clientes alta --nombre intranet --org-id 2
API_KEYS=

# Cada cuántos segundos se relee api_cliente. Es el retardo con el que surte
# efecto dar de baja a un cliente sin reiniciar el servicio.
CACHE_CLIENTES_TTL=60
# IPs y/o rangos CIDR autorizados, separados por coma.
# VACÍO = no se filtra por IP (solo aceptable en desarrollo).
IPS_PERMITIDAS=127.0.0.1,::1
# Proxies de confianza: solo desde estas IPs se hace caso a X-Forwarded-For
# para determinar la IP real del cliente. Vacío = se ignora la cabecera.
TRUSTED_PROXIES=

CORS_ORIGINS=*
